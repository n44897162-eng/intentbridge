{
  "name": "intentbridge",
  "version": "0.1.0",
  "private": true,
  "description": "IntentBridge — cross-platform intent execution layer (Action IR, Rust runtime, Web/Windows/Android providers)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:rust": "cargo build --workspace --release && cargo build -p ib-runtime --lib --release --target wasm32-unknown-unknown",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "node scripts/lint.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:rust": "cargo test --workspace",
    "gate": "node scripts/gate.mjs",
    "package": "node scripts/package.mjs",
    "fixture:web": "pnpm --filter @intentbridge/web-fixture start",
    "shell:web": "pnpm --filter @intentbridge/web-shell start",
    "sbom": "node scripts/sbom.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-check": "^3.23.2",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0"
  }
}
