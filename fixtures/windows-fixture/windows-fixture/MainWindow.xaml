<Window x:Class="IntentBridge.Fixture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IntentBridge Windows Fixture" Height="620" Width="980"
        AutomationProperties.AutomationId="fixture-window">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="IntentBridge Fixture" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock x:Name="VariantLabel" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#5b6b83" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="FormColumn" Width="340" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#ffffff" CornerRadius="12" Padding="18" BorderBrush="#dde4ef" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="客户报告检索" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="输入关键词后检索本地夹具数据。" Foreground="#66758c" Margin="0,4,0,14" TextWrapping="Wrap" />
          <TextBlock x:Name="KeywordLabel" Text="搜索" Foreground="#66758c" FontSize="12" />
          <TextBox x:Name="KeywordBox" Margin="0,4,0,10" Padding="8"
                   AutomationProperties.AutomationId="keyword-input"
                   AutomationProperties.Name="搜索" />
          <Button x:Name="SearchButton" Content="搜索" Padding="10" HorizontalAlignment="Left"
                  AutomationProperties.AutomationId="search-submit"
                  AutomationProperties.Name="搜索"
                  Click="OnSearch" />
          <TextBlock x:Name="ErrorText" Foreground="#b42318" Margin="0,8,0,0" Visibility="Collapsed" />
          <Button x:Name="ExtraButton" Content="搜索" Margin="0,16,0,0" HorizontalAlignment="Left"
                  AutomationProperties.AutomationId="search-submit-ghost"
                  AutomationProperties.Name="搜索"
                  Visibility="Collapsed" />
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="20,0,0,0">
        <StackPanel>
          <TextBlock x:Name="Summary" Foreground="#66758c" Margin="0,0,0,10"
                     AutomationProperties.AutomationId="results-summary" Text="输入关键词开始检索" />
          <ListBox x:Name="Results" Height="380"
                   AutomationProperties.AutomationId="results-list" />
          <Button Content="打开详情" Margin="0,12,0,0" HorizontalAlignment="Left"
                  Click="OnOpenDetail"
                  AutomationProperties.AutomationId="open-detail" AutomationProperties.Name="打开详情" />
        </StackPanel>
        <Border x:Name="DetailDialog" Visibility="Collapsed" Background="#f9fbff"
                BorderBrush="#c9d8ff" BorderThickness="1" CornerRadius="12"
                AutomationProperties.AutomationId="detail-dialog" AutomationProperties.Name="报告详情">
          <StackPanel Margin="24">
            <TextBlock Text="报告详情" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="DetailText" Margin="0,10,0,16" TextWrapping="Wrap" />
            <Button Content="关闭" HorizontalAlignment="Left" Click="OnCloseDetail"
                    AutomationProperties.AutomationId="close-detail" AutomationProperties.Name="关闭" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
