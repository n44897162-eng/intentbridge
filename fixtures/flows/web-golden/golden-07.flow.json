{
  "schema_version": "1.0.0",
  "flow_id": "a1000007-0000-4000-8000-000000000007",
  "name": "同源 iframe 表单",
  "description": "同源 iframe 的候选快照、帧内定位与动作。",
  "platform": "web",
  "app_scope": {
    "kind": "web-origin",
    "value": "http://127.0.0.1:4317"
  },
  "variables": [
    {
      "name": "keyword",
      "type": "string",
      "required": true
    }
  ],
  "permissions": [
    "read-ui",
    "read-screen",
    "click",
    "type",
    "select",
    "scroll",
    "launch",
    "navigate"
  ],
  "steps": [
    {
      "id": "open",
      "action": "launch",
      "name": "打开搜索页",
      "risk": "normal",
      "postconditions": [
        {
          "kind": "element-present",
          "target": {
            "anchors": {
              "semantic": {
                "role": "textbox",
                "name": "搜索",
                "placeholder": "输入关键词",
                "test_id": "keyword-input"
              },
              "native_identity": {
                "kind": "web-test-id",
                "value": "keyword-input"
              },
              "structure": {
                "path": ["main.page", "form#search-form", "input#keyword"]
              },
              "visual": {
                "norm_rect": {
                  "x": 0.18,
                  "y": 0.2,
                  "w": 0.42,
                  "h": 0.05
                },
                "viewport": {
                  "w": 1280,
                  "h": 800
                },
                "device_scale": 1
              }
            },
            "confidence": {
              "mode": "balanced"
            }
          }
        }
      ],
      "params": {
        "app_id": "http://127.0.0.1:4317",
        "url": "http://127.0.0.1:4317/",
        "wait_ready": true
      }
    },
    {
      "id": "type-keyword",
      "action": "input",
      "name": "输入关键词",
      "risk": "normal",
      "target": {
        "anchors": {
          "semantic": {
            "role": "textbox",
            "name": "搜索",
            "placeholder": "输入关键词",
            "test_id": "keyword-input"
          },
          "native_identity": {
            "kind": "web-test-id",
            "value": "keyword-input"
          },
          "structure": {
            "path": ["main.page", "form#search-form", "input#keyword"]
          },
          "visual": {
            "norm_rect": {
              "x": 0.18,
              "y": 0.2,
              "w": 0.42,
              "h": 0.05
            },
            "viewport": {
              "w": 1280,
              "h": 800
            },
            "device_scale": 1
          }
        },
        "confidence": {
          "mode": "balanced"
        }
      },
      "postconditions": [
        {
          "kind": "window-stable",
          "min_stable_ms": 120
        }
      ],
      "params": {
        "value": "${keyword}",
        "clear_first": true
      }
    },
    {
      "id": "frame-type",
      "action": "input",
      "name": "iframe 内输入",
      "risk": "normal",
      "target": {
        "anchors": {
          "semantic": {
            "role": "textbox",
            "name": "嵌入搜索",
            "test_id": "frame-input"
          },
          "native_identity": {
            "kind": "web-test-id",
            "value": "frame-input"
          }
        },
        "confidence": {
          "mode": "balanced"
        }
      },
      "postconditions": [
        {
          "kind": "window-stable",
          "min_stable_ms": 100
        }
      ],
      "params": {
        "value": "${keyword}",
        "clear_first": true
      }
    },
    {
      "id": "frame-submit",
      "action": "click",
      "name": "iframe 内提交",
      "risk": "normal",
      "target": {
        "anchors": {
          "semantic": {
            "role": "button",
            "name": "提交",
            "test_id": "frame-submit"
          },
          "native_identity": {
            "kind": "web-test-id",
            "value": "frame-submit"
          }
        },
        "confidence": {
          "mode": "balanced"
        }
      },
      "postconditions": [
        {
          "kind": "text-matches",
          "target": {
            "anchors": {
              "native_identity": {
                "kind": "web-test-id",
                "value": "frame-result"
              }
            },
            "confidence": {
              "mode": "balanced"
            }
          },
          "matcher": {
            "type": "contains",
            "value": "已提交",
            "case_sensitive": false
          }
        }
      ],
      "params": {
        "button": "left"
      }
    },
    {
      "id": "assert-frame",
      "action": "assert",
      "name": "iframe 结果可见",
      "params": {
        "condition": {
          "kind": "element-present",
          "target": {
            "anchors": {
              "native_identity": {
                "kind": "web-test-id",
                "value": "frame-result"
              }
            },
            "confidence": {
              "mode": "balanced"
            }
          }
        }
      }
    },
    {
      "id": "done",
      "action": "end",
      "name": "完成",
      "params": {
        "status": "success"
      }
    }
  ],
  "created_by": "fixture-web",
  "revision": 1,
  "created_at": "2026-01-01T00:00:00.000Z",
  "updated_at": "2026-01-01T00:00:00.000Z",
  "labels": {
    "suite": "web-golden"
  },
  "defaults": {
    "evidence_policy": {
      "capture": "target",
      "save_on": "failure",
      "retention_days": 7,
      "mask_text": true
    }
  }
}
